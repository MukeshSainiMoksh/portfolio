# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/portfolio_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DATABASE_NAME=portfolio_db

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — JSON array of allowed origins (pydantic-settings requires JSON for lists)
# Production example: ALLOWED_ORIGINS=["https://yourdomain.com","https://admin.yourdomain.com"]
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Storage backend — "local" or "s3".
#
# "local" writes to UPLOAD_DIR. Fine for development and for a VPS with a real
# disk. On Render/Railway/Fly-without-a-volume the filesystem is ephemeral, so
# every deploy wipes uploaded resumes and certificate badges — use "s3" there.
#
# "s3" works with any S3-compatible bucket. Cloudflare R2 is the cheapest
# option (10GB free, no egress charges):
#   1. Create an R2 bucket, then enable public access on it (r2.dev or a
#      custom domain) — R2 has no per-object ACLs.
#   2. Create an API token with Object Read & Write for that bucket.
#   3. Set S3_PUBLIC_BASE_URL to the bucket's public URL, and set
#      NEXT_PUBLIC_MEDIA_URL to the same value for both Next.js apps so
#      next/image will load from that host.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=
S3_PUBLIC_BASE_URL=

# Admin seed user (used by seed_admin.py) — change the password before deploying
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=admin123

# Email (Gmail SMTP) — SMTP_PASSWORD is a Gmail App Password, not the account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# AI Chatbot (OpenAI) — chat endpoint returns 503 if unset
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Environment — set ENVIRONMENT=production and DEBUG=False when deploying.
# In production the app refuses to boot with a default SECRET_KEY or ADMIN_PASSWORD,
# and the interactive API docs (/docs, /redoc) are disabled.
ENVIRONMENT=development
DEBUG=True
